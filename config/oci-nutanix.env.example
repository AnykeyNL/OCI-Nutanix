# =============================================================================
# OCI-Nutanix configuration
# Copy to config/oci-nutanix.env and fill in the values marked (required).
# The file is sourced by bash (scripts/lib/common.sh); quote values with spaces.
# =============================================================================

# --- OCI placement -----------------------------------------------------------
# (required) compartment that will hold the image, instance and volumes
COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaaa_replace_me
# (required) private subnet for the node. The iSCSI NIC, the AHV host IP and
# the CVM IP all come from this subnet. The admin host must be able to reach it.
SUBNET_ID=ocid1.subnet.oc1..aaaaaaaa_replace_me
# availability domain, e.g. "Xckh:ME-DUBAI-1-AD-1". Default: first AD of the
# region. Pick one that has capacity for the bare-metal shape.
#AD=
# region. Default: the region of your OCI CLI profile (~/.oci/config).
#OCI_CLI_REGION=me-dubai-1

# --- Source ISO (Object Storage) --------------------------------------------
# (required) bucket that holds the stock Nutanix CE ISO you downloaded from
# the Nutanix Community Edition page (needs a free NEXT account).
SRC_BUCKET=my-bucket
# object name of the ISO inside that bucket
SRC_ISO_OBJECT=phoenix.x86_64-fnd_5.6.1_patch-aos_6.8.1_ga.iso

# --- Remastered image --------------------------------------------------------
# bucket for the bare-metal ISO built by scripts/02-build-iso.sh.
# Default: SRC_BUCKET.
#IMG_BUCKET=
# display name of the OCI custom image (also the object name, "<name>.iso").
# Bump it when you rebuild the ISO.
IMAGE_NAME=nutanix-ce-ocibm-v1

# --- Node ---------------------------------------------------------------------
NODE_NAME=ce-bm-01
SHAPE=BM.Standard3.64
BOOT_VOLUME_GB=100          # holds the installer first, then AHV
CVM_VOLUME_GB=400           # CVM boot + metadata (SSD tier)
DATA_VOLUME_GB=600          # storage pool
VOLUME_VPUS_PER_GB=30       # block volume performance (10 balanced, 20 higher, 30+ ultra)

# --- Behaviour ---------------------------------------------------------------
# back up the finalized boot volume before the first AHV boot (yes/no)
BACKUP_BOOT_VOLUME=yes
# where ISOs, kernel source and build output live on the admin host (~25 GB)
WORK_DIR=/var/tmp/oci-nutanix
# Nutanix CE defaults: installer root, AHV root and CVM "nutanix" user.
# Prism "admin" also starts with this password and must be changed at first login.
CE_PASSWORD='nutanix/4u'
# OCI NTP/DNS service address (reachable from private subnets)
OCI_SERVICES_IP=169.254.169.254
# optional: SSH public key file; if set, scripts/04-launch-instance.sh creates
# an instance console connection (VNC) so you can watch the installer boot.
#CONSOLE_SSH_PUBKEY_FILE=/root/.ssh/id_rsa.pub
